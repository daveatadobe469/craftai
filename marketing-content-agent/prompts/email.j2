  "subject": "<compelling subject line, 40-60 chars>",
  "preheader": "<inbox preview text that complements the subject, max 120 chars>",
  "body_intro": "<opening paragraph that hooks the persona, uses \\n for breaks>",
  "benefits": [
    "<concrete benefit 1 tied to a persona pain point, grounded in context>",
    "<concrete benefit 2>",
    "<concrete benefit 3 (optional)>"
  ],
  "body_close": "<closing paragraph that reinforces the value and leads into the CTA>",
  "cta": "<primary call-to-action button text, max 30 chars>",
  "secondary_cta": "<optional secondary action, max 30 chars, or empty string>",
  "footer": {
