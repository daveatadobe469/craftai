# CraftAI — environment template.  cp .env.example .env  and fill in what you need.
#
# MINIMUM TO RUN: set GROQ_API_KEY and nothing else. The image feature is off by
# default, so no image or storage credentials are required to start the app.
# Every value below is optional unless marked REQUIRED — the shown value is the
# built-in default, so you can delete any line you are not changing.

# ── LLM (text generation) ─────────────────────────────────────────────────────
GROQ_API_KEY=<your-groq-key>          # REQUIRED — get one at console.groq.com
LLM_PROVIDER=groq                     # groq | ollama
GROQ_MODEL=llama-3.3-70b-versatile
# Local alternative to Groq (set LLM_PROVIDER=ollama):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# ── Compliance judge (leave blank to reuse the generator model/key) ───────────
JUDGE_GROQ_MODEL=llama-3.3-70b-versatile
# JUDGE_GROQ_API_KEY=

# ── Retrieval & evaluation ────────────────────────────────────────────────────
# HyDE rewrite runs on this model — a cheap "write a snippet" task. Groq meters
# tokens-per-day PER MODEL, so keeping it different from GROQ_MODEL gives HyDE its
# own daily budget and stops it starving the generator. Blank = reuse GROQ_MODEL.
RETRIEVAL_GROQ_MODEL=llama-3.1-8b-instant
# Batched CRAG grading model. Blank = reuse GROQ_MODEL (recommended). Do NOT set
# this to a small model: grading several passages in one call needs a capable
# one — the 8b model silently drops relevant chunks when grading in a batch.
CRAG_GROQ_MODEL=
EMBEDDING_MODEL=all-MiniLM-L6-v2
JUDGE_THRESHOLD=0.7                   # min LLM-judge score to pass compliance
CRAG_THRESHOLD=0.5                    # retrieval relevance cut-off
MAX_REVISIONS=3                       # rewrite attempts before forcing human review
# RAGAS runs once on the draft that reaches review (not per revision).
# Set false to skip it entirely — the quickest saving when Groq quota is tight.
RAGAS_ENABLED=true

# ── Storage paths ─────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_DB_PATH=./data/craftai.db
MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db

# ── Server ────────────────────────────────────────────────────────────────────
API_PORT=8000
UI_PORT=8501
ALLOWED_DOMAINS=http://localhost:8501,http://127.0.0.1:8501


# ══ IMAGE FEATURE ═════════════════════════════════════════════════════════════
# Whether a campaign gets a generated image is chosen PER BRIEF — the
# "Generate a campaign image" checkbox on the brief form (API: generate_image).
# Leave it unchecked and the draft comes back as text only, with no provider call.

# ── Image OUTPUT: campaign → image ────────────────────────────────────────────
# cloudflare = free tier, but renders text INSIDE images badly (garbled headlines)
# gemini     = legible in-image text, pay per image (~$0.02–0.06)
IMAGE_PROVIDER=cloudflare
# Cloudflare Workers AI — dash.cloudflare.com, token needs the Workers AI template
IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning
CLOUDFLARE_ACCOUNT_ID=<your-account-id>
CLOUDFLARE_API_TOKEN=<your-workers-ai-token>
# stable-diffusion-xl-lightning's field is "num_steps" (1-20, default 20).
CLOUDFLARE_IMAGE_STEPS=20
# Gemini image generation — aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-key>
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_ASPECT_RATIO=1:1                # 1:1 3:2 4:5 9:16 16:9 …
IMAGE_SIZE=1K                         # 512px | 1K | 2K | 4K

# ── Image INPUT: uploaded image → campaign copy ───────────────────────────────
# Reuses GROQ_API_KEY. NOTE: qwen3.6-27b is currently the only vision-capable
# model Groq exposes — if this 404s, list your account's models before debugging.
VISION_PROVIDER=groq
VISION_MODEL=qwen/qwen3.6-27b

# ── Image compliance judge (KNOWN LIMITATION — off by default) ────────────────
# Groq's free tier caps the vision model at 8k tokens/minute. One image costs
# ~2.6k, leaving too little room for the model to reason AND answer: it produced
# a verdict in only 3 of 7 trial runs. Generated images are human-reviewed only.
IMAGE_JUDGE_ENABLED=false
IMAGE_JUDGE_PROVIDER=groq
IMAGE_JUDGE_THRESHOLD=0.7

# ── Image storage ─────────────────────────────────────────────────────────────
# local (disk, served by the API at /media) or cloudinary (public CDN URLs).
# Case-insensitive; NONE / off / empty also mean local disk.
IMAGE_STORAGE_BACKEND=local
MEDIA_BASE_URL=http://localhost:8000
# Cloudinary — cloudinary.com, free tier, no card required.
# WARNING: uploaded images get a PERMANENT PUBLIC URL; anyone with the link can view.
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>
CLOUDINARY_FOLDER=craftai


# ══ CAMPAIGN DELIVERY over MCP (email / HTML) ═════════════════════════════════
# On approval in the review screen, an email-channel brief can be downloaded as an
# .eml or SENT over SMTP; every other channel can be downloaded as HTML. Delivery
# runs through a small MCP server that main.py starts as a subprocess.
# NONE of this is required to run the app, and .eml / HTML download need no SMTP.

# ── MCP server (started by main.py) ───────────────────────────────────────────
EMAIL_MCP_ENABLED=true
EMAIL_MCP_HOST=127.0.0.1
EMAIL_MCP_PORT=8765
EMAIL_MCP_PATH=/mcp
# EMAIL_MCP_URL=http://127.0.0.1:8765/mcp   # override only if host/port/path differ

# ── Message envelope ──────────────────────────────────────────────────────────
EMAIL_FROM=CraftAI <craftai@demo.local>
EMAIL_DEFAULT_TO=reviewer@brand.com   # prefilled recipient in the review UI

# ── SMTP (REQUIRED only for the "Send email" mode; blank SMTP_HOST = send off) ─
# Gmail: SMTP_PASSWORD must be a Google *App Password* (needs 2-Step Verification),
# NOT your normal password. Create one at Google Account → Security → App passwords.
# Sandbox alternative with no real delivery: Mailtrap (smtp.mailtrap.io).
SMTP_HOST=                            # e.g. smtp.gmail.com  (blank disables sending)
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=<your-address@gmail.com>
SMTP_PASSWORD=<your-16-char-app-password>
