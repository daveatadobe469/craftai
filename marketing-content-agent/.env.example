
# .env.example
OPENAI_API_KEY=<yourkey>

# GEMINI_API_KEY=<yourkey>

# ANTHROPIC_API_KEY=<yourkey>

GROQ_API_KEY=<yourkey>

HF_TOKEN=<yourkey>

#SERPAPI_API_KEY = <yourkey>

SENDER_EMAIL = <youremail>
RECEIVER_EMAIL = <youremail>
APP_PASSWORD = <password>
PINECONE_API_KEY=<yourkey>
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
EMBEDDING_MODEL=all-MiniLM-L6-v2
JUDGE_GROQ_MODEL=llama-3.3-70b-versatile
JUDGE_THRESHOLD=0.7
CRAG_THRESHOLD=0.5
MAX_REVISIONS=3
# RAGAS now runs once on the final draft (not per revision). false = skip entirely,
# useful when API token quota is tight or for fast demos.
RAGAS_ENABLED=true

# [image-based-campaign] Image feature (input vision + output generation)
# Master flag — false keeps the pipeline text-only (nodes become no-ops).
IMAGE_FEATURE_ENABLED=false
# Output provider: "cloudflare" (free, poor in-image text) or "gemini" (paid, legible text)
IMAGE_PROVIDER=cloudflare
# -- Cloudflare Workers AI (free tier)
IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_ACCOUNT_ID=<your-account-id>
CLOUDFLARE_API_TOKEN=<your-workers-ai-token>
# -- Gemini image generation (set IMAGE_PROVIDER=gemini to use)
GEMINI_API_KEY=<your-gemini-key>
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_ASPECT_RATIO=1:1
IMAGE_SIZE=1K
# Input: Groq vision model (reuses GROQ_API_KEY)
VISION_PROVIDER=groq
VISION_MODEL=qwen/qwen3.6-27b
# -- Image compliance judge (KNOWN LIMITATION: off by default).
#    Groq's free tier caps the vision model at 8k tokens/minute, which can't fit
#    image + reasoning + JSON answer reliably (3 of 7 trial runs succeeded), so
#    generated images are reviewed by a human only. Enable at your own risk.
IMAGE_JUDGE_ENABLED=false
IMAGE_JUDGE_PROVIDER=groq
IMAGE_JUDGE_THRESHOLD=0.7
# Storage: "local" (disk, for local dev) or "firebase"
IMAGE_STORAGE_BACKEND=local
MEDIA_BASE_URL=http://localhost:8000
# -- Firebase Storage (needed only when IMAGE_STORAGE_BACKEND=firebase)
#    pip install firebase-admin
FIREBASE_CREDENTIALS_PATH=<path/to/serviceAccount.json>
FIREBASE_STORAGE_BUCKET=<your-project.appspot.com>
FIREBASE_SIGNED_URL_TTL_DAYS=7
