# Example environment values for Docker-based deployment
GROQ_API_KEY=your-groq-key
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:latest
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=/app/data/chroma
SQLITE_DB_PATH=/app/data/craftai.db
MLFLOW_TRACKING_URI=sqlite:////app/data/mlflow.db
API_PORT=8000
UI_PORT=8501
ALLOWED_DOMAINS=http://localhost:8501,http://127.0.0.1:8501
EMAIL_MCP_ENABLED=false
